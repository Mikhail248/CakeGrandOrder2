<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="CakeGrandOrder.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:CakeGrandOrder.Views"
    Shell.FlyoutBehavior="Locked"
    Title="CakeGrandOrder">
  
    <ShellContent
        Title="Login"
        ContentTemplate="{DataTemplate local:LoginPage}"
        Route="LoginPage" />
    <ShellContent
      Title="Cakes"
      ContentTemplate="{DataTemplate local:DefaultCakesPage}"
      Route="DefaultCakesPage" />
    <ShellContent
        Title="Register"
        ContentTemplate="{DataTemplate local:RegisterPage}"
        Route="RegisterPage" />
    <ShellContent
    Title="Cart"
    ContentTemplate="{DataTemplate local:CartPage}"
    Route="CartPage" />
    <ShellContent
Title="Orders"
ContentTemplate="{DataTemplate local:OrdersPage}"
Route="OrdersPage" />
</Shell>
