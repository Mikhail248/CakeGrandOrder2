<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="CakeGrandOrder.AppShellAuth"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:CakeGrandOrder.Views"
    Shell.FlyoutBehavior="Flyout"
    Title="CakeGrandOrder">
    <ShellContent
      Title="Cakes"
      ContentTemplate="{DataTemplate local:DefaultCakesPage}"
      Route="DefaultCakesPage" />
    <ShellContent
    Title="Cart"
    ContentTemplate="{DataTemplate local:CartPage}"
    Route="CartPage" />
    <ShellContent
  Title="Custom Cakes"
  ContentTemplate="{DataTemplate local:CustomPage}"
  Route="CustomPage" />

    <ShellContent
Title="Orders"
ContentTemplate="{DataTemplate local:OrdersPage}"
Route="OrdersPage" />
    <MenuItem Clicked="MenuItem_Logout_Clicked" Text="Logout" />
</Shell>

