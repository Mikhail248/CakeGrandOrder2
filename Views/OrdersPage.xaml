<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="CakeGrandOrder.Views.OrdersPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewmodels="clr-namespace:CakeGrandOrder.ViewModels"
    Title="OrdersPage">
    <ContentPage.Resources />
    <Grid RowDefinitions="Auto,*">
        <Label Text="Here are your orders" />
        <CollectionView Grid.Row="1" ItemsSource="{Binding OrderList}">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <VerticalStackLayout Padding="10" Spacing="20">
                        <Label Text="{Binding Date}" />

                        <CollectionView ItemsSource="{Binding Cakes}">
                            <CollectionView.ItemTemplate>
                                <DataTemplate>

                                    <Grid ColumnDefinitions="*,*" RowDefinitions="*,*,*,*,*,*,*,*">

                                        <Image
                                            Grid.Row="7"
                                            IsVisible="{Binding B3}"
                                            WidthRequest="{Binding Con1}">
                                            <Image.Triggers>
                                                <DataTrigger
                                                    Binding="{Binding CakeBase}"
                                                    TargetType="Image"
                                                    Value="1">
                                                    <Setter Property="Source" Value="base1.png" />
                                                </DataTrigger>
                                                <DataTrigger
                                                    Binding="{Binding CakeBase}"
                                                    TargetType="Image"
                                                    Value="2">
                                                    <Setter Property="Source" Value="base2.png" />
                                                </DataTrigger>
                                            </Image.Triggers>
                                        </Image>

                                        <Image
                                            Grid.Row="6"
                                            IsVisible="{Binding W3}"
                                            WidthRequest="{Binding Con1}">
                                            <Image.Triggers>
                                                <DataTrigger
                                                    Binding="{Binding CakeFilling}"
                                                    TargetType="Image"
                                                    Value="1">
                                                    <Setter Property="Source" Value="filling1.png" />
                                                </DataTrigger>
                                                <DataTrigger
                                                    Binding="{Binding CakeFilling}"
                                                    TargetType="Image"
                                                    Value="2">
                                                    <Setter Property="Source" Value="filling2.png" />
                                                </DataTrigger>

                                                <DataTrigger
                                                    Binding="{Binding CakeFilling}"
                                                    TargetType="Image"
                                                    Value="3">
                                                    <Setter Property="Source" Value="filling3.png" />
                                                </DataTrigger>

                                            </Image.Triggers>
                                        </Image>
                                        <Image
                                            Grid.Row="5"
                                            IsVisible="{Binding B2}"
                                            WidthRequest="{Binding Con2}">
                                            <Image.Triggers>
                                                <DataTrigger
                                                    Binding="{Binding CakeBase}"
                                                    TargetType="Image"
                                                    Value="1">
                                                    <Setter Property="Source" Value="base1.png" />
                                                </DataTrigger>
                                                <DataTrigger
                                                    Binding="{Binding CakeBase}"
                                                    TargetType="Image"
                                                    Value="2">
                                                    <Setter Property="Source" Value="base2.png" />
                                                </DataTrigger>
                                            </Image.Triggers>
                                        </Image>

                                        <Image
                                            Grid.Row="4"
                                            IsVisible="{Binding W2}"
                                            WidthRequest="{Binding Con2}">
                                            <Image.Triggers>
                                                <DataTrigger
                                                    Binding="{Binding CakeFilling}"
                                                    TargetType="Image"
                                                    Value="1">
                                                    <Setter Property="Source" Value="filling1.png" />
                                                </DataTrigger>
                                                <DataTrigger
                                                    Binding="{Binding CakeFilling}"
                                                    TargetType="Image"
                                                    Value="2">
                                                    <Setter Property="Source" Value="filling2.png" />
                                                </DataTrigger>

                                                <DataTrigger
                                                    Binding="{Binding CakeFilling}"
                                                    TargetType="Image"
                                                    Value="3">
                                                    <Setter Property="Source" Value="filling3.png" />
                                                </DataTrigger>

                                            </Image.Triggers>
                                        </Image>

                                        <Image
                                            Grid.Row="3"
                                            IsVisible="{Binding B1}"
                                            WidthRequest="{Binding Con3}">
                                            <Image.Triggers>
                                                <DataTrigger
                                                    Binding="{Binding CakeBase}"
                                                    TargetType="Image"
                                                    Value="1">
                                                    <Setter Property="Source" Value="base1.png" />
                                                </DataTrigger>
                                                <DataTrigger
                                                    Binding="{Binding CakeBase}"
                                                    TargetType="Image"
                                                    Value="2">
                                                    <Setter Property="Source" Value="base2.png" />
                                                </DataTrigger>
                                            </Image.Triggers>
                                        </Image>

                                        <Image
                                            Grid.Row="2"
                                            IsVisible="{Binding W1}"
                                            WidthRequest="{Binding Con3}">
                                            <Image.Triggers>

                                                <DataTrigger
                                                    Binding="{Binding CakeFilling}"
                                                    TargetType="Image"
                                                    Value="1">
                                                    <Setter Property="Source" Value="filling1.png" />
                                                </DataTrigger>
                                                <DataTrigger
                                                    Binding="{Binding CakeFilling}"
                                                    TargetType="Image"
                                                    Value="2">
                                                    <Setter Property="Source" Value="filling2.png" />
                                                </DataTrigger>

                                                <DataTrigger
                                                    Binding="{Binding CakeFilling}"
                                                    TargetType="Image"
                                                    Value="3">
                                                    <Setter Property="Source" Value="filling3.png" />
                                                </DataTrigger>

                                            </Image.Triggers>
                                        </Image>

                                        <Image Grid.Row="1">
                                            <Image.Triggers>
                                                <DataTrigger
                                                    Binding="{Binding Top}"
                                                    TargetType="Image"
                                                    Value="1">
                                                    <Setter Property="Source" Value="top1.png" />
                                                </DataTrigger>
                                                <DataTrigger
                                                    Binding="{Binding Top}"
                                                    TargetType="Image"
                                                    Value="2">
                                                    <Setter Property="Source" Value="top2.png" />
                                                </DataTrigger>

                                                <DataTrigger
                                                    Binding="{Binding Top}"
                                                    TargetType="Image"
                                                    Value="3">
                                                    <Setter Property="Source" Value="top3.png" />
                                                </DataTrigger>

                                            </Image.Triggers>
                                        </Image>

                                        
                                        <VerticalStackLayout Grid.Column="1" Spacing="10">

                                            <Label
                                                Grid.Row="1"
                                                Grid.Column="0"
                                                Text=" Price: "
                                                VerticalOptions="Center" />
                                            <Label
                                                Grid.Row="1"
                                                Grid.Column="1"
                                                Text="{Binding Price}"
                                                VerticalOptions="Center" />

                                            <Label
                                                Grid.Row="2"
                                                Grid.Column="0"
                                                Text=" Fat: "
                                                VerticalOptions="Center" />
                                            <Label
                                                Grid.Row="2"
                                                Grid.Column="1"
                                                Text="{Binding Fat}"
                                                VerticalOptions="Center" />

                                            <Label
                                                Grid.Row="3"
                                                Grid.Column="0"
                                                Text=" Sugar: "
                                                VerticalOptions="Center" />
                                            <Label
                                                Grid.Row="3"
                                                Grid.Column="1"
                                                Text="{Binding Sugar}"
                                                VerticalOptions="Center" />

                                            <Label
                                                Grid.Row="4"
                                                Grid.Column="0"
                                                Text=" CakeBase: "
                                                VerticalOptions="Center" />
                                            <Label
                                                Grid.Row="4"
                                                Grid.Column="1"
                                                Text="{Binding CakeBase}"
                                                VerticalOptions="Center" />

                                            <Label
                                                Grid.Row="5"
                                                Grid.Column="0"
                                                Text=" CakeFilling: "
                                                VerticalOptions="Center" />
                                            <Label
                                                Grid.Row="5"
                                                Grid.Column="1"
                                                Text="{Binding CakeFilling}"
                                                VerticalOptions="Center" />

                                            <Label
                                                Grid.Row="6"
                                                Grid.Column="0"
                                                Text=" BaseNum: "
                                                VerticalOptions="Center" />
                                            <Label
                                                Grid.Row="6"
                                                Grid.Column="1"
                                                Text="{Binding BaseNum}"
                                                VerticalOptions="Center" />

                                            <Label
                                                Grid.Row="7"
                                                Grid.Column="0"
                                                Text=" Construction: "
                                                VerticalOptions="Center" />
                                            <Label
                                                Grid.Row="7"
                                                Grid.Column="1"
                                                Text="{Binding Construction}"
                                                VerticalOptions="Center" />

                                            <Label
                                                Grid.Row="8"
                                                Grid.Column="0"
                                                Text=" Top: "
                                                VerticalOptions="Center" />
                                            <Label
                                                Grid.Row="8"
                                                Grid.Column="1"
                                                Text="{Binding Top}"
                                                VerticalOptions="Center" />

                                            <Button
                                                Grid.Row="9"
                                                Grid.ColumnSpan="2"
                                                Command="{Binding OrderDefaultCakeCommand, Source={x:RelativeSource AncestorType={x:Type viewmodels:OrdersViewModel}, Mode=FindAncestorBindingContext}}"
                                                CommandParameter="{Binding .}"
                                                Text="Reorder" />
                                        </VerticalStackLayout>
                                    </Grid>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>

</ContentPage>