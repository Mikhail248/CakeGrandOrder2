<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CakeGrandOrder.Views.RegisterPage"
             Title="RegisterPage">
    <VerticalStackLayout>
        <Entry Placeholder="User Name" Text="{Binding UserName}"/>
        <Grid  ColumnDefinitions="*,Auto">
            <Entry Grid.Column="0" Placeholder="Password" Text="{Binding UserPassword}" IsPassword="{Binding ShowPassword}"/>
            <Button Grid.Column="1" Text="SP" Command="{Binding TogglePasswordCommand}"/>
        </Grid>
        <Button Command="{Binding ResetCommand}" Text="Reset Field"/>
        <Button Text="Already have an account?" Command="{Binding LinkToLoginPageCommand}"/>
    </VerticalStackLayout>
</ContentPage>