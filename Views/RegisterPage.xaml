<ContentPage
    x:Class="CakeGrandOrder.Views.RegisterPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewmodels="clr-namespace:CakeGrandOrder.ViewModels"
    Title="RegisterPage"
    x:DataType="viewmodels:RegisterViewModel">

    <Grid Padding="40,60,40,40" RowDefinitions="Auto,*,Auto">

        
        <VerticalStackLayout
            Grid.Row="0"
            Margin="0,0,0,50"
            Spacing="10">
            <Label
                FontAttributes="Bold"
                FontSize="36"
                HorizontalOptions="Center"
                Text="Create Account" />
            <Label
                FontSize="16"
                HorizontalOptions="Center"
                Opacity="0.7"
                Text="Sign up to get started" />
        </VerticalStackLayout>

        <VerticalStackLayout
            Grid.Row="1"
            Spacing="24"
            VerticalOptions="Center">

            <Frame Padding="0" HasShadow="False">
                <Entry
                    Margin="16,12"
                    FontSize="16"
                    Placeholder="Email"
                    Text="{Binding UserName}" />
            </Frame>

            <Frame Padding="0" HasShadow="False">
                <Grid Padding="16,12" ColumnDefinitions="*,Auto">
                    <Entry
                        Grid.Column="0"
                        FontSize="16"
                        IsPassword="{Binding ShowPassword}"
                        Placeholder="Password"
                        Text="{Binding UserPassword}" />
                    <Button
                        Grid.Column="1"
                        Padding="12,0"
                        BackgroundColor="Transparent"
                        Command="{Binding TogglePasswordCommand}"
                        FontSize="12"
                        Text="👁"
                        TextColor="{StaticResource Gray500}" />
                </Grid>
            </Frame>

            <Label
                FontSize="14"
                HorizontalOptions="End"
                Text="Reset Fields"
                TextColor="{StaticResource Primary}">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding ResetCommand}" />
                </Label.GestureRecognizers>
            </Label>

            <Button
                Margin="0,12,0,0"
                Command="{Binding RegisterCommand}"
                CornerRadius="12"
                FontAttributes="Bold"
                FontSize="18"
                HeightRequest="56"
                Text="Register" />

        </VerticalStackLayout>

        <StackLayout
            Grid.Row="2"
            HorizontalOptions="Center"
            Orientation="Horizontal"
            Spacing="6">
            <Label FontSize="14" Text="Already have an account?" />
            <Label
                FontAttributes="Bold"
                FontSize="14"
                Text="Login"
                TextColor="{StaticResource Primary}">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding LinkToLoginPageCommand}" />
                </Label.GestureRecognizers>
            </Label>
        </StackLayout>

    </Grid>

</ContentPage>